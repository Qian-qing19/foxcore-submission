.login-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48rpx 40rpx;
}

.brand {
  align-items: center;
  display: flex;
  flex-direction: column;
  margin-bottom: 48rpx;
}

.brand-mark {
  align-items: center;
  background: #146c5a;
  border-radius: 24rpx;
  color: #ffffff;
  display: flex;
  font-size: 52rpx;
  font-weight: 700;
  height: 104rpx;
  justify-content: center;
  margin-bottom: 24rpx;
  width: 104rpx;
}

.brand-title {
  color: #153f36;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-subtitle {
  color: #74827e;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.login-card {
  padding: 36rpx 32rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  color: #3d514c;
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field-input {
  background: #f5f9f8;
  border: 1rpx solid #dce9e5;
  border-radius: 14rpx;
  color: #1f2d2a;
  font-size: 30rpx;
  height: 88rpx;
  padding: 0 24rpx;
}

.placeholder {
  color: #a2aeaa;
}

.login-button {
  margin-top: 12rpx;
  width: 100%;
}