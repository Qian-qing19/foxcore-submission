<view class="container">
  <view
    wx:if="{{demoMode}}"
    style="background: #fff4d6; border: 1rpx solid #efd28a; border-radius: 12rpx; color: #765a14; font-size: 25rpx; margin-bottom: 24rpx; padding: 18rpx 22rpx;"
  >演示模式：当前使用内置示例数据</view>

  <view class="page-header">
    <view class="welcome-block">
      <text class="welcome-title">你好，{{username}}</text>
      <text class="welcome-subtitle">今天也要顺利成交</text>
    </view>
    <button class="logout-button" bindtap="onLogout">退出登录</button>
  </view>

  <view wx:if="{{loading}}" class="card loading-card">正在加载工作台...</view>

  <block wx:else>
    <view class="card shift-card">
      <view class="section-title">当前班次</view>
      <block wx:if="{{hasShift}}">
        <text class="event-name">{{eventName}}</text>
        <view class="shift-row">
          <text class="shift-label">摊位</text>
          <text class="shift-value">{{boothText}}</text>
        </view>
        <view class="shift-row">
          <text class="shift-label">时间</text>
          <text class="shift-value">{{shiftTime}}</text>
        </view>
      </block>
      <view wx:else class="no-shift">当前没有进行中的班次，请联系合伙人排班</view>
    </view>

    <view class="section-title summary-title">业绩概览</view>
    <view class="summary-grid">
      <view class="summary-card">
        <text class="summary-label">今日销售额</text>
        <text class="summary-value">¥{{todaySales}}</text>
      </view>
      <view class="summary-card">
        <text class="summary-label">本月销售额</text>
        <text class="summary-value">¥{{monthSales}}</text>
      </view>
      <view class="summary-card summary-card-wide">
        <text class="summary-label">本月佣金</text>
        <text class="summary-value">¥{{monthCommission}}</text>
      </view>
    </view>

    <view class="action-group">
      <button
        class="btn-primary action-button"
        disabled="{{!hasShift}}"
        bindtap="onGoSale"
      >登记销售</button>
      <button class="btn-secondary action-button" bindtap="onGoSales">我的销售</button>
    </view>
  </block>
</view>