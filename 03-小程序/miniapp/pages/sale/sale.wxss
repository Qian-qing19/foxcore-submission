.loading-card {
  color: #74827e;
  text-align: center;
}

.shift-card {
  margin-bottom: 24rpx;
}

.shift-event {
  color: #146c5a;
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.shift-meta {
  color: #74827e;
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.form-card,
.cart-card {
  margin-bottom: 24rpx;
}

.picker-field {
  background: #f5f9f8;
  border: 1rpx solid #dce9e5;
  border-radius: 14rpx;
  color: #1f2d2a;
  font-size: 28rpx;
  min-height: 84rpx;
  padding: 22rpx 24rpx;
}

.input-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.input-group {
  flex: 1;
}

.field-label {
  color: #3d514c;
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.field-input {
  background: #f5f9f8;
  border: 1rpx solid #dce9e5;
  border-radius: 14rpx;
  color: #1f2d2a;
  font-size: 30rpx;
  height: 84rpx;
  padding: 0 20rpx;
  width: 100%;
}

.min-price {
  color: #74827e;
  display: block;
  font-size: 24rpx;
  margin: 14rpx 0 20rpx;
}

.add-button {
  width: 100%;
}

.cart-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.cart-title {
  margin-bottom: 0;
}

.cart-count {
  color: #74827e;
  font-size: 24rpx;
}

.cart-item {
  align-items: center;
  border-bottom: 1rpx solid #edf3f1;
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
}

.cart-item-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.cart-item-name {
  color: #263b35;
  font-size: 27rpx;
  font-weight: 600;
}

.cart-item-meta {
  color: #74827e;
  font-size: 23rpx;
  margin-top: 4rpx;
}

.cart-item-side {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.line-amount {
  color: #146c5a;
  font-size: 28rpx;
  font-weight: 700;
}

.remove-button {
  background: transparent;
  color: #b14a42;
  font-size: 23rpx;
  line-height: 1;
  margin: 8rpx 0 0;
  padding: 10rpx 0 10rpx 16rpx;
}

.total-row {
  align-items: center;
  display: flex;
  font-size: 30rpx;
  font-weight: 600;
  justify-content: space-between;
  padding: 26rpx 0;
}

.total-amount {
  color: #146c5a;
  font-size: 40rpx;
}

.submit-button {
  width: 100%;
}